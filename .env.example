# YouTube Research - TubeLab API
# Get your key from https://tubelab.net/developers
TUBELAB_API_KEY=your-api-key-here

# X/Twitter Research - Apify API
# Get your token from https://console.apify.com/account/integrations
APIFY_TOKEN=your-apify-token-here

# Video Analysisr - Gemini API
# Get your token from https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-key

# OmniRoute - gateway de IA (só se você tiver um servidor OmniRoute rodando)
# A chave fica no painel do OmniRoute, em API Keys
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_KEY=sk-your-key
