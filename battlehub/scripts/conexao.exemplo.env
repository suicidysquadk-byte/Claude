# Copie este arquivo para scripts/conexao.env e preencha. O conexao.env NÃO vai para o GitHub.

# --- Supabase (obrigatório) -------------------------------------------------
# Painel do Supabase → canto de baixo à esquerda (seu avatar) → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=
# Painel do projeto → Project Settings → General → Reference ID (ex.: abcdefghijklmnopqrst)
SUPABASE_PROJECT_REF=

# --- Login com Google (recomendado) -----------------------------------------
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Pix automático pelo Mercado Pago (opcional; sem ele o Pix é manual) ----
# Mercado Pago Developers → Suas integrações → Credenciais de produção → Access Token
MP_ACCESS_TOKEN=
# Mercado Pago Developers → Webhooks → Assinatura secreta (depois de cadastrar a URL que o script mostra)
MP_WEBHOOK_SECRET=

# --- Notificação no celular (opcional) ---------------------------------------
# Firebase → Configurações do projeto → Contas de serviço → Gerar nova chave privada (baixa um .json).
# Coloque o caminho do arquivo aqui. Ele é secreto: salve na pasta scripts/ (o git ignora *.json ali e qualquer
# arquivo *firebase-adminsdk*.json) e nunca mande em lugar público.
FCM_SERVICE_ACCOUNT_FILE=

# Asaas (opcional): recebe o Pix, guarda e paga os saques sozinho. Comece pelo sandbox.
ASAAS_API_KEY=
# sandbox ou producao
ASAAS_ENV=sandbox
# invente uma senha longa (32+ caracteres); cadastre a mesma no Asaas, no webhook e na validação de saque
ASAAS_WEBHOOK_TOKEN=

# Efí Bank (opcional): segundo gateway, recebe e paga Pix. Comece pela homologação.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# chave Pix da conta Efí que recebe os depósitos e paga os saques
EFI_PIX_KEY=
# homologacao ou producao
EFI_ENV=homologacao
# certificado .p12 do Efí em base64 (o painel do app converte: Configurações → Gateway → Certificado do Efí)
EFI_CERT_P12=
# senha longa inventada por você (vai no endereço do aviso)
EFI_WEBHOOK_TOKEN=
