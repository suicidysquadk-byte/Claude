{
  "appId": "gg.battlehub.app",
  "appName": "BattleHub",
  "webDir": "www",
  "backgroundColor": "#070605",
  "android": {
    "backgroundColor": "#070605",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
